import React from 'react';
import type { DripperSupportParams } from '../types';

const WALL = 2.4;

interface Props {
  params: DripperSupportParams;
}

export function CrossSection({ params }: Props) {
  const {
    dripperInnerDiam,
    dripperOuterDiam,
    bottleMouthInnerDiam,
    bottleMouthDepth,
  } = params;

  const bottleR = bottleMouthInnerDiam / 2;
  const dripperInR = dripperInnerDiam / 2;
  const dripperOutR = dripperOuterDiam / 2;
  const flangeOutR = bottleR + WALL;
  const topRingH = 11;
  const funnelH = Math.max(WALL * 2, dripperOutR - bottleR);

  const y0 = 0;
  const y1 = bottleMouthDepth;
  const y2 = y1 + funnelH;
  const y3 = y2 + topRingH;

  // SVG canvas
  const SVG_W = 260;
  const SVG_H = 230;
  const PAD_X = 28;
  const PAD_Y = 18;

  const totalMmH = y3;
  const totalMmW = dripperOutR + WALL + 6;

  const sx = Math.min(2.8, (SVG_W / 2 - PAD_X - 10) / totalMmW);
  const sy = Math.min(sx, (SVG_H - PAD_Y * 2) / totalMmH);

  // Axis X = PAD_X (centre line)
  const ax = PAD_X;

  const tx = (r: number) => ax + r * sx;
  const ty = (y: number) => PAD_Y + (totalMmH - y) * sy;

  type Pt = [number, number];

  const rightProfile: Pt[] = [
    [Math.max(0.5, bottleR - WALL), y0],
    [Math.max(0.5, bottleR - WALL), y0],
    [bottleR, y1],
    [flangeOutR, y1],
    [flangeOutR, y1 + WALL],
    [dripperOutR, y2],
    [dripperOutR, y3],
    [dripperInR, y3],
    [dripperInR, y2],
    [Math.max(0.5, bottleR - WALL), y1 + WALL],
    [Math.max(0.5, bottleR - WALL), y0],
  ];

  const toD = (pts: Pt[]) =>
    pts.map(([r, y], i) => `${i === 0 ? 'M' : 'L'}${tx(r).toFixed(1)},${ty(y).toFixed(1)}`).join(' ') + ' Z';

  // Mirror left side
  const toMirrorD = (pts: Pt[]) =>
    pts.map(([r, y], i) => `${i === 0 ? 'M' : 'L'}${(ax - r * sx).toFixed(1)},${ty(y).toFixed(1)}`).join(' ') + ' Z';

  const accent = '#c87941';
  const dimCol = '#7b9ea6';

  const DimH = ({ r1, r2, mmY, label, side = 1 }: { r1: number; r2: number; mmY: number; label: string; side?: number }) => {
    const x1 = tx(r1), x2 = tx(r2);
    const yPos = ty(mmY) - 10 * side;
    const mid = (x1 + x2) / 2;
    return (
      <>
        <line x1={x1} y1={yPos} x2={x2} y2={yPos} stroke={dimCol} strokeWidth="0.8" markerEnd="url(#arr)" markerStart="url(#arrl)" />
        <text x={mid} y={yPos - 3} textAnchor="middle" fontSize="6.5" fill={dimCol} fontFamily="DM Sans">{label}</text>
      </>
    );
  };

  return (
    <svg viewBox={`0 0 ${SVG_W} ${SVG_H}`} width="100%" style={{ display: 'block' }}>
      <defs>
        <marker id="arr" markerWidth="5" markerHeight="5" refX="4" refY="2.5" orient="auto">
          <path d="M0,0 L5,2.5 L0,5 Z" fill={dimCol} />
        </marker>
        <marker id="arrl" markerWidth="5" markerHeight="5" refX="1" refY="2.5" orient="auto-start-reverse">
          <path d="M0,0 L5,2.5 L0,5 Z" fill={dimCol} />
        </marker>
      </defs>

      {/* Axis */}
      <line x1={ax} y1={PAD_Y - 8} x2={ax} y2={SVG_H - PAD_Y + 8}
        stroke="#444" strokeWidth="0.6" strokeDasharray="5,3" />

      {/* Profile — right */}
      <path d={toD(rightProfile)} fill={accent} fillOpacity="0.15" stroke={accent} strokeWidth="1.3" strokeLinejoin="round" />
      {/* Profile — left (mirror) */}
      <path d={toMirrorD(rightProfile)} fill={accent} fillOpacity="0.15" stroke={accent} strokeWidth="1.3" strokeLinejoin="round" />

      {/* Dimension lines */}
      <DimH r1={0} r2={dripperOutR} mmY={y3} label={`⌀${dripperOuterDiam.toFixed(1)}`} side={1} />
      <DimH r1={0} r2={dripperInR} mmY={y3 - topRingH * 0.5} label={`⌀${dripperInnerDiam.toFixed(1)}`} side={-1} />
      <DimH r1={0} r2={bottleR} mmY={y1} label={`⌀${bottleMouthInnerDiam.toFixed(1)}`} side={1} />

      {/* Height dimension — right side */}
      <line
        x1={tx(dripperOutR) + 7} y1={ty(y3)}
        x2={tx(dripperOutR) + 7} y2={ty(y0)}
        stroke={dimCol} strokeWidth="0.8"
        markerEnd="url(#arr)" markerStart="url(#arrl)"
      />
      <text
        x={tx(dripperOutR) + 16}
        y={(ty(y3) + ty(y0)) / 2 + 4}
        fontSize="6.5"
        fill={dimCol}
        fontFamily="DM Sans"
        textAnchor="middle"
        transform={`rotate(-90,${tx(dripperOutR) + 16},${(ty(y3) + ty(y0)) / 2})`}
      >
        h={y3.toFixed(1)}
      </text>

      {/* Depth brace */}
      <line x1={ax - 4} y1={ty(y0)} x2={ax + 4} y2={ty(y0)} stroke="#555" strokeWidth="0.7" />
      <line x1={ax - 4} y1={ty(y1)} x2={ax + 4} y2={ty(y1)} stroke="#555" strokeWidth="0.7" />
      <text x={ax - 8} y={(ty(y0) + ty(y1)) / 2 + 3} fontSize="6" fill="#666" fontFamily="DM Sans" textAnchor="middle"
        transform={`rotate(-90,${ax - 8},${(ty(y0) + ty(y1)) / 2})`}>
        {`d=${bottleMouthDepth.toFixed(1)}`}
      </text>
    </svg>
  );
}